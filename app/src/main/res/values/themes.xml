<resources>
    <!--
      Фон, акцент и текст берутся из colors.xml; ночные значения лежат
      в values-night/ под теми же именами, тема одна на обе.
      NoActionBar: заголовок «Соучастник» и так есть в лок-апе наверху
      экрана, панель дублировала бы его.
    -->
    <style name="Theme.Souchastnik" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/brand_red</item>
        <item name="colorPrimary">@color/brand_bg</item>
        <item name="colorPrimaryDark">@color/brand_bg</item>
        <item name="android:windowBackground">@color/brand_bg</item>
        <item name="android:colorBackground">@color/brand_bg</item>
        <!-- Светлый фон статус-бара требует тёмных иконок; ночью наоборот. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
