<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ТОЛЬКО DEBUG. BenchActivity объявлена здесь, а не в главном манифесте,
      чтобы её не было в релизном APK.

      Она обязана быть exported: запускают её из adb, а `am start` идёт от
      UID shell, и невыгруженный компонент чужого приложения он поднять не
      может. Но exported-активити может дёрнуть ЛЮБОЕ установленное
      приложение, а эта грузит полугигабайтную модель и гоняет замеры. В
      релизе такого сюрприза быть не должно.

      Замер теперь снимать с debug-сборки. Числа сравнимы с прежними:
      аргументы CMake заданы в defaultConfig, то есть нативная часть в обеих
      сборках компилируется одинаково (-DCMAKE_BUILD_TYPE=Release, все
      варианты ядер ggml-cpu с выбором в рантайме), а замеряется именно она.

        adb shell am start -n dev.souchastnik/.engine.BenchActivity
        adb logcat -s souchastnik-bench:I souchastnik-native:I
    -->
    <application>
        <activity
            android:name=".engine.BenchActivity"
            android:exported="true"
            android:label="Bench" />
    </application>

</manifest>
